__pycache__/
*.pyc
*.egg-info/
build/
.pytest_cache/
outbox/
# demo/out is generated EXCEPT the committed deliverables: the Phase-10
# reliability figure and the Phase-12 pitch assets (the container that renders
# them is ephemeral; regen commands are in PITCH_ASSETS.md).
demo/out/*
!demo/out/calibration_v2.png
!demo/out/real/
demo/out/real/*
!demo/out/real/*.png
!demo/out/pitch_assets/
demo/out/pitch_assets/*
!demo/out/pitch_assets/*.png

# Bulk generated data stays out; the small trained artifacts that make a
# fresh clone runnable (surrogate + detector checkpoints) are committed.
data/*
!data/checkpoints
data/checkpoints/*
!data/checkpoints/best.pt
!data/checkpoints/best_v1.pt
!data/checkpoints/detect_cnn.pt
!data/checkpoints/detect_gbm.joblib
# Real-data detector checkpoints (Round 4; trained on real data only)
!data/checkpoints/detect_real_gbm.pkl
!data/checkpoints/detect_real_cnn.pt

# --- Real-data workspace (roadmap step NOW; see data/real/README.md) --------
# Bulk real data NEVER enters git: raw downloads, interim parquet and
# model-ready processed sets stay local. The directory skeleton and the small
# provenance files (.gitkeep, MANIFEST.yaml, INVENTORY.md, SOURCE.md) DO get
# tracked, so the contract survives a fresh clone.
# `data/*` above already excluded data/real, and git does not descend into an
# excluded directory, so data/real is re-included first; the `**/` negations
# re-include DIRECTORIES only, which is what lets the per-file negations below
# match inside nested dataset folders.
!data/real/
data/real/raw/**
data/real/interim/**
data/real/processed/**
!data/real/raw/**/
!data/real/interim/**/
!data/real/processed/**/
!data/real/**/.gitkeep
!data/real/**/MANIFEST.yaml
!data/real/**/INVENTORY.md
!data/real/**/SOURCE.md
